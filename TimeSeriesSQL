SELECT distinct
 main.[PolId] as PolicyId,
 (main.PmAmt*main.PmRoe) AS PremiumAmount,
 main.EstSgnPctg as EstimatedSignedPercentage,
 WtnLn as WrittenLine,
 pm.AcctgYr,pm.Srce as ContractType, (SELECT  (CONVERT(DATETIME,IncpDt,103))) as InceptionDate
from  [Subscribe_SUP].[dbo].PolMain main
right join  [Subscribe_SUP].[dbo].InPol pm  on main.PolId= pm.PolId

where main.PmAmt is not null and polty in ('NONMARINE','MARINE','AVIATION') and (SELECT Year (CONVERT(DATETIME,IncpDt,103))) between 2013 and 2025
order by AcctgYr
